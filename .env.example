# Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click a text channel in Discord (with Developer Mode on) -> Copy Channel ID
CHANNEL_ID=

# Optional. Restricts command registration to specific server(s), comma-
# separated for more than one. Useful for a dev/test bot that should stay out
# of other servers. Leave empty (the default, use this for prod) to register
# to every server the bot is currently in — new servers get commands
# instantly too, via the GuildCreate handler in index.ts.
GUILD_ID=

# Optional. Channel the rank embed links to for Master / Apex Predator proof.
# Left empty, the embed says "#rank-check" as plain text instead of a link.
RANK_CHECK_CHANNEL_ID=

# Required for /maprotation, /predator and /status. Free key from
# https://api.mozambiquehe.re/getkey
APEX_API_KEY=

# Optional. Where /lfg posts its squad cards. Defaults to the LFG channel the
# "lfg" message in content/messages.json already points at.
LFG_CHANNEL_ID=

# Optional. Default channel for `/predator post`. Left empty, it posts to
# whichever channel the command was run in.
PREDATOR_CHANNEL_ID=

# Optional. Voice channels that create a temporary squad room when someone
# joins them ("join to create"), comma-separated for more than one — e.g. one
# hub per platform. Empty (the default) turns the feature off.
VOICE_HUB_IDS=

# Optional. Same, but rooms made from these hubs start locked: nobody else can
# connect until the owner lets them in with /room invite or hands out the room
# code the bot DMs them. Owners can also lock a public room later with
# /room lock, so this hub is a shortcut, not the only way in.
VOICE_HUB_PRIVATE_IDS=

# Optional. Set to "on" to DM new members the "welcome-dm" message from
# content/messages.json. This needs the privileged SERVER MEMBERS INTENT ticked
# in the Developer Portal (Your App -> Bot -> Privileged Gateway Intents) —
# without it the bot cannot log in at all while this is on.
WELCOME_DM=

# Optional. Path to the /create message definitions. Defaults to the committed
# content/messages.json — point this somewhere outside the repo if you edit the
# messages on the server and don't want `git pull` to fight your changes.
MESSAGES_FILE=

# Optional. Postgres connection string of the tournament website's database
# (Supabase -> Project Settings -> Database -> Connection string). Empty turns
# tournament sign-ups off. The bot needs the Manage Roles permission, and its
# own role must sit above where the "Captain" role gets created.
DATABASE_URL=

# Optional. Your community's own server. The Apex features and their slash
# commands only live there; other servers just get tournament announcements,
# and a server no organizer connected through the website is left again after
# ten minutes. Empty keeps the one-server setup (every server counts as home).
HOME_GUILD_ID=

# Account the entry-fee QR codes pay into. Empty uses a placeholder IBAN.
PAYMENT_IBAN=

# The tournament website, used in the sign-up links the bot hands out.
# Defaults to https://tournevo.com.
SITE_URL=
