# Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click a text channel in Discord (with Developer Mode on) -> Copy Channel ID
CHANNEL_ID=

# Optional. Server(s) to register slash commands to, comma-separated for more
# than one — instant, ideal for a dev/test bot. Leave empty to register
# globally instead: slower to propagate (up to an hour) but covers every
# server the bot is in, including ones it joins later. Use this for prod.
GUILD_ID=

# Optional. Channel the rank embed links to for Master / Apex Predator proof.
# Left empty, the embed says "#rank-check" as plain text instead of a link.
RANK_CHECK_CHANNEL_ID=
